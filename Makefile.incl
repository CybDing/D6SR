######################################################################
#  球形机器人项目编译配置文件
#  基于libopencm3标准配置，适配项目目录结构
#
#  本文件是整个编译系统的核心，定义了:
#  1. 交叉编译工具链配置 (ARM GCC)
#  2. STM32F407VET6 目标配置
#  3. 编译器标志和优化选项
#  4. 链接器配置和库文件
#  5. 自动化构建规则
######################################################################

# 交叉编译工具链前缀
# ARM交叉编译工具链，将x86代码编译为ARM架构
# 需要安装: sudo apt-get install gcc-arm-none-eabi
PREFIX		?= arm-none-eabi

# 目录路径配置
# TOP_DIR: 项目根目录，通过Makefile位置自动获取
# OPENCM3_DIR: libopencm3库的绝对路径
TOP_DIR 	:= $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
OPENCM3_DIR 	:= $(abspath $(TOP_DIR)/libopencm3)

# STM32F407VET6配置 (512KB Flash, 128KB RAM)
LIBNAME		= opencm3_stm32f4          # 使用STM32F4系列库
DEFS		= -DSTM32F4 -DUSE_STM32F407 # 预定义宏
ARCH_FLAGS	= -mthumb -mcpu=cortex-m4 -mfloat-abi=hard -mfpu=fpv4-sp-d16
#             ↑ Thumb指令集  ↑ Cortex-M4内核  ↑ 硬件浮点  ↑ FPU类型

# 汇编标志
ASFLAGS		= -mthumb $(patsubst -mcpu=%,-mcpu=%,$(filter -mcpu=%,$(ARCH_FLAGS)))

# 工具链定义
CC		:= $(PREFIX)-gcc
CXX		:= $(PREFIX)-g++
LD		:= $(PREFIX)-gcc
AR		:= $(PREFIX)-ar
AS		:= $(PREFIX)-as
OBJCOPY		:= $(PREFIX)-objcopy
SIZE		:= $(PREFIX)-size
OBJDUMP		:= $(PREFIX)-objdump
GDB		:= $(PREFIX)-gdb
STFLASH		= $(shell which st-flash)

# 代码风格检查工具
STYLECHECK	:= /checkpatch.pl
STYLECHECKFLAGS	:= --no-tree -f --terse --mailback
STYLECHECKFILES	:= $(shell find . -name '*.[ch]')

# 编译优化选项 (移除调试信息以节省Flash空间)
OPT		:= -Os
CSTD		?= -std=c99

# 源文件到对象文件的转换规则
TEMP1 		= $(patsubst %.c,%.o,$(SRCFILES))
TEMP2		= $(patsubst %.asm,%.o,$(TEMP1))
OBJS 		= $(patsubst %.cpp,%.o,$(TEMP2))

# C编译标志 (优化Flash使用)
TGT_CFLAGS	+= $(OPT) $(CSTD)
TGT_CFLAGS	+= $(ARCH_FLAGS)
TGT_CFLAGS	+= -Wextra -Wshadow -Wimplicit-function-declaration
TGT_CFLAGS	+= -Wredundant-decls -Wmissing-prototypes -Wstrict-prototypes
TGT_CFLAGS	+= -fno-common -ffunction-sections -fdata-sections
TGT_CFLAGS	+= -I$(OPENCM3_DIR)/include
TGT_CFLAGS	+= -I$(TOP_DIR)rtos/FreeRTOS-Kernel/include
TGT_CFLAGS	+= -I$(TOP_DIR)rtos/FreeRTOS-Kernel/portable/GCC/ARM_CM4F

# C++编译标志
TGT_CXXFLAGS	+= $(OPT) $(CXXSTD)
TGT_CXXFLAGS	+= $(ARCH_FLAGS)
TGT_CXXFLAGS	+= -Wextra -Wshadow -Wredundant-decls  -Weffc++
TGT_CXXFLAGS	+= -fno-common -ffunction-sections -fdata-sections

# 预处理器标志
TGT_CPPFLAGS	+= -MD
TGT_CPPFLAGS	+= -Wall -Wundef
TGT_CPPFLAGS	+= $(DEFS)
TGT_CPPFLAGS	+= -I$(OPENCM3_DIR)/include
TGT_CPPFLAGS	+= -I$(TOP_DIR)rtos/FreeRTOS-Kernel/include
TGT_CPPFLAGS	+= -I$(TOP_DIR)rtos/FreeRTOS-Kernel/portable/GCC/ARM_CM4F

# 链接器标志 (优化Flash使用)
TGT_LDFLAGS	+= --static -nostartfiles
TGT_LDFLAGS	+= -T$(LDSCRIPT)
TGT_LDFLAGS	+= $(ARCH_FLAGS)
TGT_LDFLAGS	+= -Wl,-Map=$(*).map
TGT_LDFLAGS	+= -Wl,--gc-sections

# 链接库
LDLIBS		+= -specs=nosys.specs
LDLIBS		+= -Wl,--start-group -lc -lgcc -lnosys -lm -Wl,--end-group
LDLIBS		+= -L$(OPENCM3_DIR)/lib -l$(LIBNAME)

# 文件后缀定义
.SUFFIXES:	.elf .bin .hex .srec .list .map .images
.SECONDEXPANSION:
.SECONDARY:

# 编译目标定义
elf:	$(DEPS) $(BINARY).elf
bin:	$(DEPS) $(BINARY).bin
hex:	$(DEPS) $(BINARY).hex
srec:	$(DEPS) $(BINARY).srec
list:	$(DEPS) $(BINARY).list

# 调试打印宏 - 使用方法: make print-OPENCM3_DIR
print-%:
	@echo $*=$($*)

# 镜像文件生成规则
%.images: %.bin %.hex %.srec %.list %.map
	@#printf "*** $* images generated ***\n"

# ELF转二进制
%.bin: %.elf
	@#printf "  OBJCOPY $(*).bin\n"
	$(OBJCOPY) -Obinary $(*).elf $(*).bin

# ELF转Intel HEX
%.hex: %.elf
	@#printf "  OBJCOPY $(*).hex\n"
	$(OBJCOPY) -Oihex $(*).elf $(*).hex

# ELF转Motorola S-record
%.srec: %.elf
	@#printf "  OBJCOPY $(*).srec\n"
	$(OBJCOPY) -Osrec $(*).elf $(*).srec

# 生成反汇编列表
%.list: %.elf
	@#printf "  OBJDUMP $(*).list\n"
	$(OBJDUMP) -S $(*).elf > $(*).list

# 链接生成ELF文件
%.elf %.map: $(OBJS) $(LDSCRIPT)
	$(LD) $(TGT_LDFLAGS) $(LDFLAGS) $(OBJS) $(LDLIBS) -o $(*).elf
	$(SIZE) $(BINARY).elf

# C文件编译规则
%.o: %.c
	@#printf "  CC      $(*).c\n"
	$(CC) $(TGT_CFLAGS) $(CFLAGS) $(TGT_CPPFLAGS) $(CPPFLAGS) -o $(*).o -c $(*).c

# C++文件编译规则
%.o: %.cxx
	@#printf "  CXX     $(*).cxx\n"
	$(CXX) $(TGT_CXXFLAGS) $(CXXFLAGS) $(TGT_CPPFLAGS) $(CPPFLAGS) -o $(*).o -c $(*).cxx

%.o: %.cpp
	@#printf "  CXX     $(*).cpp\n"
	$(CXX) $(TGT_CXXFLAGS) $(CXXFLAGS) $(TGT_CPPFLAGS) $(CPPFLAGS) -o $(*).o -c $(*).cpp

# 汇编文件编译规则
%.o: %.asm
	$(AS) $(ASFLAGS) -o $*.o -c $<

# 清理目标文件
clean:
	@#printf "  CLEAN\n"
	$(RM) *.o *.d generated.* $(OBJS) $(patsubst %.o,%.d,$(OBJS))

# 完全清理
clobber: clean
	rm -f *.elf *.bin *.hex *.srec *.list *.map $(CLOBBER)

# 烧录程序
flash:	$(BINARY).bin
	$(STFLASH) --reset $(FLASHSIZE) write $(BINARY).bin 0x8000000

.PHONY: images clean elf bin hex srec list all

# 包含依赖文件
-include $(OBJS:.o=.d)

######################################################################
# 重要参数说明:
#
# PREFIX      - ARM交叉编译工具链前缀
# ARCH_FLAGS  - CPU架构相关标志 (Cortex-M4F)
# OPT         - 优化级别 (-Os=大小优化, -O2=速度优化)
# CSTD        - C语言标准 (-std=c99)
# DEFS        - 预定义宏 (-DSTM32F4)
# LDSCRIPT    - 链接脚本路径
# LIBNAME     - libopencm3库名称
#
# 编译标志详解:
# -mthumb               - 使用Thumb指令集
# -mcpu=cortex-m4       - 目标CPU类型
# -mfloat-abi=hard      - 使用硬件浮点 (FPv4-SP)
# -ffunction-sections   - 每个函数单独段，利于链接器优化
# -fdata-sections       - 每个数据单独段
# -Wl,--gc-sections     - 链接时移除未使用段
# -specs=nosys.specs    - 无操作系统规范
######################################################################

# End